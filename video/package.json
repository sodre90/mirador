{
  "name": "mirador-trailer",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "cd .. && bunx playwright test -c video/playwright.config.ts",
    "encode": "bun capture/encode.ts",
    "narrate": "bun narration/narrate.ts",
    "music": "bun audio/compose.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Trailer out/render.mp4 --codec=h264 --crf=16 --audio-bitrate=320k --concurrency=8 && bun audio/master.ts",
    "build": "bun run narrate && bun run capture && bun run encode && bun run music && bun run render",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test tests/"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.534",
    "@remotion/media": "4.0.534",
    "mermaid": "12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  }
}
