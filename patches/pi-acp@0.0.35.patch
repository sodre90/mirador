new file mode 100644
index 0000000000000000000000000000000000000000..c4306d0e36ba2fd75786c378a621e7c63105b956
--- /dev/null
+++ b/dist/retry-notices.js
@@ -0,0 +1,28 @@
+/**
+ * pi's automatic retries as ACP notices: each attempt a line of its own that says why it failed, and a last line when pi
+ * gave up, rather than text run into the agent's reply. Mirador, this patch's only client, always takes notices; the
+ * SDK pi-acp bundles drops the `session.notices` capability that would say so.
+ */
+export function retryNotice(event) {
+  return {
+    sessionUpdate: "notice",
+    severity: "warning",
+    title: retryTitle(event),
+    ...(event.errorMessage ? { description: String(event.errorMessage) } : {}),
+  };
+}
+
+export function gaveUpNotice(event) {
+  const retries = Number(event.attempt);
+  const title = Number.isFinite(retries) && retries > 0 ? `Gave up after ${retries} ${retries === 1 ? "retry" : "retries"}` : "Gave up retrying";
+  return { sessionUpdate: "notice", severity: "warning", title };
+}
+
+function retryTitle(event) {
+  const attempt = Number(event.attempt);
+  const maxAttempts = Number(event.maxAttempts);
+  const delayMs = Number(event.delayMs);
+  if (!Number.isFinite(attempt) || !Number.isFinite(maxAttempts) || !Number.isFinite(delayMs)) return "Retrying";
+  const delaySeconds = delayMs > 0 ? Math.max(1, Math.round(delayMs / 1e3)) : 0;
+  return `Retrying (attempt ${attempt}/${maxAttempts}, waiting ${delaySeconds}s)`;
+}
