@@ -0,0 +1,67 @@
+/**
+ * Loaded into each pi that pi-acp starts for a session with MCP servers or added system prompt text. It hands the
+ * servers the ACP client sent in session/new, session/load or session/resume to pi's built-in MCP support, with their
+ * tools declared to the model directly, adds the client's `_meta.systemPrompt.append` to pi's system prompt, and marks
+ * the user messages steered into a run.
+ */
+const SESSION_VARIABLE = "PI_ACP_SESSION";
+const SESSION_KEY = Symbol.for("pi-acp.session");
+
+/**
+ * Read once per process, as a reload loads the extension again, and taken out of the environment, which the bash tool's
+ * commands inherit, since server headers and environments can hold credentials.
+ */
+function sessionOptions() {
+  globalThis[SESSION_KEY] ??= JSON.parse(process.env[SESSION_VARIABLE] ?? "{}");
+  delete process.env[SESSION_VARIABLE];
+  return globalThis[SESSION_KEY];
+}
+
+const asObject = (pairs) => Object.fromEntries((pairs ?? []).map(({ name, value }) => [name, value]));
+
+function piServerConfig(server) {
+  if (server.type === "http") return { url: server.url, headers: asObject(server.headers) };
+  return { command: server.command, args: server.args ?? [], env: asObject(server.env) };
+}
+
+/**
+ * The custom entry naming, by its timestamp, a user message that joined a run: pi records it as any other user message.
+ * A fork at that message leaves the mark at the end of the new session, so the mark names its message rather than
+ * standing next to it.
+ */
+export const STEER_MARK = "pi-acp.steer";
+
+/**
+ * Marks each user message of a run but the one it started with, so a fork can tell the message that started a turn from
+ * those steered into it. pi writes a message to the session only after the extensions' message_end handlers ran, so the
+ * mark comes just before it.
+ */
+function markSteeredMessages(pi) {
+  let awaitingRunsPrompt = false;
+  pi.on("before_agent_start", ({ messageType }) => {
+    awaitingRunsPrompt = messageType !== "custom";
+  });
+  pi.on("message_end", ({ message }) => {
+    if (message?.role !== "user") return;
+    if (awaitingRunsPrompt) awaitingRunsPrompt = false;
+    else pi.appendEntry(STEER_MARK, { timestamp: message.timestamp });
+  });
+}
+
+/** pi.registerMcpServer came in pi 0.99.0, and before_agent_start's systemPromptOptions with it. */
+const OLDEST_PI = "0.99.0";
+
+export default function (pi) {
+  if (typeof pi.registerMcpServer !== "function") {
+    throw new Error(`Mirador needs pi ${OLDEST_PI} or later. Update pi with npm install -g @earendil-works/pi-coding-agent`);
+  }
+  const { mcpServers = [], appendSystemPrompt = "" } = sessionOptions();
+  for (const server of mcpServers) pi.registerMcpServer(server.name, { ...piServerConfig(server), exposure: "direct" });
+  // Not pi's --append-system-prompt, which would take the place of the APPEND_SYSTEM.md files pi finds.
+  if (appendSystemPrompt) {
+    pi.on("before_agent_start", ({ systemPromptOptions }) => {
+      systemPromptOptions.appendSystemPrompt = [systemPromptOptions.appendSystemPrompt, appendSystemPrompt].filter(Boolean).join("\n\n");
+    });
+  }
+  markSteeredMessages(pi);
+}
