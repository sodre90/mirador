@@ -0,0 +1,43 @@
+import { STEER_MARK } from "./session-extension.js";
+
+/** pi has no id for a message, so its timestamp, which the session file keeps with it, stands in for one. */
+export function piMessageId(message) {
+  const timestamp = message?.timestamp;
+  return typeof timestamp === "number" ? String(timestamp) : void 0;
+}
+
+/**
+ * The fork that leaves the session with what it had up to the agent message `messageId` and the rest of that message's
+ * turn: cut at the next message that started a turn, or with `atSteeredMessage`, at the next user message of any kind,
+ * as the client goes back to one that joined a running turn. pi records both kinds alike, so the session extension
+ * marks the steered ones. Null when the branch has no such agent message.
+ */
+export function forkCommandAt(entries, leafId, messageId, atSteeredMessage = false) {
+  const branch = currentBranch(entries, leafId);
+  const pointIndex = branch.findLastIndex((entry) => isMessage(entry, "assistant") && piMessageId(entry.message) === messageId);
+  if (pointIndex === -1) return null;
+  const steered = steeredMessageTimestamps(branch);
+  const isCut = (entry) => isMessage(entry, "user") && (atSteeredMessage || !steered.has(entry.message.timestamp));
+  const cut = branch.slice(pointIndex + 1).find(isCut);
+  return cut ? { type: "fork", entryId: cut.id } : { type: "clone" };
+}
+
+function currentBranch(entries, leafId) {
+  const unvisited = new Map(entries.map((entry) => [entry.id, entry]));
+  const branch = [];
+  for (let id = leafId; id && unvisited.has(id); ) {
+    const entry = unvisited.get(id);
+    unvisited.delete(id);
+    branch.unshift(entry);
+    id = entry.parentId;
+  }
+  return branch;
+}
+
+function steeredMessageTimestamps(branch) {
+  return new Set(branch.filter((entry) => entry.type === "custom" && entry.customType === STEER_MARK).map((entry) => entry.data?.timestamp));
+}
+
+function isMessage(entry, role) {
+  return entry.type === "message" && entry.message?.role === role;
+}
